{
  "expo": {
    "name": "Sheet: to do",
    "slug": "sheet-to-do",
    "version": "0.4.0",
    "orientation": "default",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "sheettodo",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.lilydotsenko.sheettodo",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#F39874",
        "foregroundImage": "./assets/branding/app-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/vnd.sheet-to-do.list"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.sheet-to-do.list"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/octet-stream"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream"
            }
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7D5C4",
          "image": "./assets/branding/app-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6652be6e-05ea-4223-9ebe-48433fb43e62"
      }
    },
    "owner": "sugar4vaders-team"
  }
}
